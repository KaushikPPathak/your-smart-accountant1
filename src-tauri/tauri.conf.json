{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartAccountant",
  "version": "1.0.0",
  "identifier": "com.smartaccountant.app",
  "build": {
    "beforeBuildCommand": "bun run build:tauri",
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist/client"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "upgradeCode": "F7E5A1C2-4B6D-4C8A-9F2E-1A3B5C7D9E11"
      },
      "allowDowngrades": false
    },
    "publisher": "Your Mehtaji",
    "copyright": "\u00a9 2026 Your Mehtaji",
    "category": "Business",
    "shortDescription": "GST-ready offline accounting for Indian businesses",
    "longDescription": "Smart Accountant (Your Mehtaji) is an offline-first accounting and GST compliance suite for Indian businesses. Multi-company books, sales and purchase vouchers, inventory, bank reconciliation and GSTR-1/2B/3B reports \u2014 all stored locally on your PC."
  },
  "plugins": {
    "shell": {
      "open": ".*"
    },
    "sql": {
      "preload": []
    }
  }
}
